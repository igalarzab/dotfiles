{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/mise/shims/dcg"
          }
        ]
      }
    ]
  },
  "theme": "auto",
  "tui": "fullscreen",
  "permissions": {
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": true
  },
  "model": "opus",
  "enableWorkflows": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  }
}
