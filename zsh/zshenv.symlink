# Keep zsh configuration under ~/.config/zsh.
export ZDOTDIR="$HOME/.config/zsh"

typeset -ga dotfiles_baseline_env
dotfiles_baseline_env=(${(k)parameters[(R)*export*]})

export DOTFILES="${DOTFILES:-${${(%):-%x}:A:h:h}}"
typeset -U PATH path

source "$DOTFILES/shells/pre-init.sh"

# Login shells load this in .zprofile, after macOS's path_helper reorders PATH.
if [[ ! -o login ]]; then
  for dotfiles_file in "$DOTFILES"/*/env.sh(N); do
    source "$dotfiles_file"
  done
  unset dotfiles_file
fi
